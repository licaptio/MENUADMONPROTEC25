<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/provsoft_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editar recordatorio" android:textStyle="bold" android:textSize="24sp" />
        <Button android:id="@+id/btnDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" />
        <Button android:id="@+id/btnTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="14dp"
            android:gravity="top|start" android:padding="14dp" android:background="@drawable/bg_card" android:inputType="textMultiLine" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
            <LinearLayout android:id="@+id/editImageContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        <Button android:id="@+id/btnAddImages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="AGREGAR IMÁGENES" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="GUARDAR CAMBIOS" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
