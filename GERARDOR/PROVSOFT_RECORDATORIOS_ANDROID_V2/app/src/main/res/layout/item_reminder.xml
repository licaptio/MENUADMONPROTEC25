<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginVertical="6dp" android:background="@drawable/bg_card"
    android:orientation="vertical" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="17sp" android:textColor="@color/provsoft_text" android:maxLines="1" />
    <TextView android:id="@+id/tvDate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:textStyle="bold" android:textSize="13sp" android:textColor="#667085" />
    <TextView android:id="@+id/tvMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:maxLines="2" android:ellipsize="end" android:textColor="#344054" />
</LinearLayout>
