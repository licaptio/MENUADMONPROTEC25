<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="28dp"
    android:background="#101828">

    <ImageView
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="34dp"
        android:src="@drawable/ic_alarm_clock"
        android:contentDescription="Alarma PROVSOFT" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="PROVSOFT"
        android:textColor="#FFB4B4"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="RECORDATORIO PENDIENTE"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/tvAlarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#D0D5DD"
        android:textSize="19sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Horario de descanso: 23:00 a 05:00"
        android:textColor="#98A2B3"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAttend"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="34dp"
        android:text="ATENDER / VER RECORDATORIO"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSnooze30"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="POSPONER 30 MIN"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSnooze4Hours"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:text="POSPONER 4 HORAS"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnTomorrow"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:text="POSPONER PARA MAÑANA"
        android:textStyle="bold" />

</LinearLayout>
