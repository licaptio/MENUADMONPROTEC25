<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Provsoft" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/provsoft_red</item>
        <item name="colorPrimaryVariant">@color/provsoft_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101828</item>
