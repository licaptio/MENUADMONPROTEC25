<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/provsoft_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/tvDetailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="24sp" />
        <TextView android:id="@+id/tvDetailDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#667085" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:id="@+id/imageContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:id="@+id/tvDetailMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:padding="16dp" android:textSize="16sp" android:textIsSelectable="true" />
        <Button android:id="@+id/btnEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="EDITAR" />
        <Button android:id="@+id/btnMarkDone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="MARCAR ATENDIDO" />
    </LinearLayout>
</ScrollView>
