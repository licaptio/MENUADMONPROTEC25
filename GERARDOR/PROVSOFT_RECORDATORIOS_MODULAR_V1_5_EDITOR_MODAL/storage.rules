rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /recordatorios/{recordatorioId}/{archivo} {
      allow read: if true;
      // Subir/reemplazar imágenes
      allow create, update: if request.resource != null
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Permitir borrar una imagen al quitarla desde el editor.
      allow delete: if true;
    }
  }
}
